# ==============================================================================
# CONFIGURAZIONE VARIABILI D'AMBIENTE - MARKET READER
# ==============================================================================
# Rinomina questo file in `.env.local` per l'ambiente di sviluppo locale.
# Configura le stesse variabili nella dashboard del tuo provider di hosting (es. Vercel).

# ------------------------------------------------------------------------------
# 1. AUTENTICAZIONE APPLICAZIONE
# ------------------------------------------------------------------------------
# Password per accedere alla dashboard web dell'applicazione
APP_PASSWORD=tua_password_sicura

# ------------------------------------------------------------------------------
# 2. DATI DI MERCATO (TWELVE DATA)
# ------------------------------------------------------------------------------
# Chiave API per scaricare le serie temporali OHLC di XAU/USD (15m)
# Ottenibile gratuitamente su: https://twelvedata.com/
TWELVE_DATA_API_KEY=la_tua_twelve_data_api_key

# ------------------------------------------------------------------------------
# 3. INTELLIGENZA ARTIFICIALE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Chiave API per l'analisi tecnica approfondita e i parametri operativi
# Ottenibile su: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=la_tua_gemini_api_key

# ------------------------------------------------------------------------------
# 4. SICUREZZA CRON JOB & AUTOMAZIONE
# ------------------------------------------------------------------------------
# Stringa segreta per proteggere l'endpoint /api/check-market da chiamate non autorizzate.
# Deve corrispondere al secret CRON_SECRET salvato su GitHub Actions / Vercel Cron.
CRON_SECRET=un_segreto_molto_lungo_e_casuale_12345

# ------------------------------------------------------------------------------
# 5. NOTIFICHE TELEGRAM BOT
# ------------------------------------------------------------------------------
# Token del bot creato con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID dell'utente o del canale/gruppo dove ricevere gli alert operativi
# (Puoi ricavarlo inviando un messaggio a @userinfobot o @getidsbot su Telegram)
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 6. URL APPLICAZIONE
# ------------------------------------------------------------------------------
# URL pubblico dell'app per generare i link diretti nei messaggi Telegram
# Sviluppo locale: http://localhost:3000
# Produzione: https://tuo-progetto.vercel.app
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. PERSISTENZA STATO & COOLDOWN (VERCEL KV / UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Configura le variabili fornite da Vercel KV o Upstash Redis:
# Se usi Vercel KV (Storage -> Create KV Database):
KV_REST_API_URL=https://tuo-kv.upstash.io
KV_REST_API_TOKEN=tuo_kv_token

# Oppure se usi direttamente Upstash Redis (upstash.com):
UPSTASH_REDIS_REST_URL=https://tuo-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=tuo_upstash_token

# ------------------------------------------------------------------------------
# 8. SCHEDULAZIONE AUTOMATICA (UPSTASH QSTASH)
# ------------------------------------------------------------------------------
# Chiavi di firma crittografica fornite da Upstash QStash (console.upstash.com/qstash)
# Utilizzate per verificare l'header Upstash-Signature nelle chiamate schedulate
QSTASH_CURRENT_SIGNING_KEY=sig_curr_xxxxxxxxxxxxxxxxxxxxxxxx
QSTASH_NEXT_SIGNING_KEY=sig_next_xxxxxxxxxxxxxxxxxxxxxxxx


