# ====================================================================
# MARKETREADER - CONFIGURAZIONE VARIABILI D'AMBIENTE
# ====================================================================
# Copia questo file in '.env.local' nella root del progetto:
#   cp .env.example .env.local
# Inserisci le tue chiavi e la password prima di avviare l'applicazione.
# ====================================================================

# 1. PASSWORD DI ACCESSO ALL'APPLICAZIONE (Obbligatoria per proteggere la piattaforma)
# Password richiesta nella pagina /login per accedere ai grafici e alle API.
APP_PASSWORD=una_password_sicura_a_tua_scelta_123

# 2. TWELVE DATA API KEY (Obbligatoria per i dati di mercato live)
# Registrati gratuitamente su: https://twelvedata.com
# Utilizzata per recuperare le candele OHLC su timeframe 15m (XAU/USD).
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# 3. GOOGLE GEMINI API KEY (Obbligatoria per l'analisi tecnica assistita con IA)
# Ottieni una chiave gratuita con piano Google AI Pro / AI Studio su: https://aistudio.google.com
# Supporta automaticamente il fallback multi-modello (gemini-3.6-flash, 3.5-flash, ecc.).
GEMINI_API_KEY=your_gemini_api_key_here
